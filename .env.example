# Discord
DISCORD_TOKEN=Bot YOUR_TOKEN
CHANNEL_ID=1234567890

# Binance USDT-M Futures (API key needs Futures Trading; do NOT enable Withdraw)
BINANCE_API_KEY=xxxxx
BINANCE_API_SECRET=xxxxx
BINANCE_TESTNET=false

# Margin mode set per symbol before first leverage-call. ISOLATED caps
# the loss on each position to its own margin (recommended for SHORTs
# with a tight SL); CROSSED uses the whole wallet as cushion.
MARGIN_MODE=ISOLATED

# Trading
CATEGORY=linear
QUOTE=USDT
DEFAULT_LEVERAGE=5

# Per-symbol leverage overrides. Use only when you want to force a specific
# leverage; otherwise the bot now AUTO-DETECTS each symbol's max leverage
# from Bybit's instrument-info and falls back to that automatically.
# Format: "BASE:LEVERAGE,..." (no USDT suffix; float OK like 12.5).
# Risk_pct auto-scales so notional/risk stays constant per trade.
# Common low-leverage coins: SIREN=5x, B/FHE/HIGH=12.5x.
# Setting these is OPTIONAL — auto-detect handles it; overrides are just for
# pinning a specific value.
LEVERAGE_OVERRIDES=SIREN:5,B:12.5,FHE:12.5,HIGH:12.5

# Pre-warm Bybit caches at bot start. For each base symbol listed, the bot
# fetches instrument-info and issues set_leverage in parallel BEFORE the
# first signal arrives. Eliminates the 300-450ms cold-path penalty on the
# first trade per symbol after a Railway redeploy.
# Format: comma-separated base symbols (no USDT suffix).
# Set this to the coins your provider trades most often.
WARMUP_SYMBOLS=BTC,ETH,SOL,DYDX,SIREN,UB,BILL,NIL,MAVIA,TSTBSC,JTO,B3,PIEVERSE,PLAYSOUT,B,FHE,HIGH,DYM,LAB,HMSTR,CLO,IO,GIGA,CORE,WLFI,QU,1000TAG,M,ZEREBRO,4,RAVE,NAORIS,BSB,CHILLGUY,US

# Blacklisted base symbols — incoming signals are SKIPPED.
# From backtest of 1095 trades: HIGH had -3.2% EV/trade.
BLACKLIST_SYMBOLS=HIGH

# Risk / Limits
MAX_CONCURRENT_TRADES=3
MAX_TRADES_PER_DAY=20

# Entry rules
ENTRY_EXPIRATION_MIN=180
ENTRY_TOO_FAR_PCT=0.5          # wenn Preis schon zu weit "durch" ist -> skip
ENTRY_TRIGGER_BUFFER_PCT=0.0    # optional: trigger leicht vorziehen
ENTRY_LIMIT_PRICE_OFFSET_PCT=0.00 # optional: limit leicht aggressiver machen (gegen miss-fill)

# SL/TP behavior
INITIAL_SL_PCT=19.0                 # fallback if signal has no SL AND FIXED_RISK_PROFILE=false
MOVE_SL_TO_BE_ON_TP1=true
# When TP1 reached, move SL to entry × (1 ± buffer%). Backtest shows 1.0%
# captures most of the move while still protecting against retracements.
BREAKEVEN_PROFIT_BUFFER_PCT=1.0

# Fixed risk profile — overrides signal SL/TPs with hardcoded percentages.
# Backtest-optimised values (1095-trade Binance backtest: +6.49% EV/sig,
# 63% WR, ~38% MaxDD with 10% margin × 20x):
#   SL=2.0%, TPs at 0.8/1.6/4.0%
FIXED_RISK_PROFILE=true
FIXED_SL_PCT=2.0
FIXED_TP_PCTS=0.8,1.6,4.0

# TP splits — 3 TPs (TP4 from signal is ignored, ~40% target is unrealistic).
# Backtest winner: 0,100,0 = full size out at TP2 (1.6%). 5/95/0 also
# acceptable if you want to clear fees on TP1.
TP_SPLITS=0,100,0

# DCA sizing (position add % vom initial qty)
DCA_QTY_MULTS=1.0,1.0,1.0      # kannst du später ändern (zB 1.5/1.0/0.5)

# Discord Gateway WebSocket (push, ~50-300ms latency)
# Replaces REST-polling for new messages. Edit-polling for TRADE CLOSED /
# CANCELLED detection still runs on REST (every 60s, not time-critical).
# If Gateway fails GATEWAY_FALLBACK_FAILURES times in a row, falls back to REST.
USE_GATEWAY_WS=true
GATEWAY_FALLBACK_FAILURES=3
GATEWAY_LOOP_SLEEP_SEC=0.5
GATEWAY_INITIAL_BACKFILL=true

# REST polling for new messages (only used as fallback when Gateway WS is
# disabled / failing). When Gateway is healthy these values don't matter.
POLL_SECONDS=15
POLL_JITTER_MAX=5

# Edit polling: how often to re-fetch open/pending trade messages to detect
# TRADE CLOSED / TRADE CANCELLED from the signal provider. Not time-critical.
SIGNAL_UPDATE_INTERVAL_SEC=60       # pending trades
SIGNAL_UPDATE_INTERVAL_OPEN_SEC=60  # open trades

# Logging / Safety
DRY_RUN=false
